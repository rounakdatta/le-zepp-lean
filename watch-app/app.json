{
  "configVersion": "v3",
  "app": {
    "appId": 83419,
    "appName": "LeZeppLean",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "le-zepp-lean",
    "description": "Listens to the music around you and shows time-synced lyrics"
  },
  "permissions": [
    "device:os.mic",
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.4",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/home/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "LeZeppLean"
    }
  },
  "defaultLanguage": "en-US"
}
